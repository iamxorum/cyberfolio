TURNSTILE_SECRET_KEY=keyyyyy
# Contact details shown after Turnstile and printed on the CV. Keep them out of config files.
CONTACT_EMAIL=you@example.com
# Optional. Shown after Turnstile and printed on the downloaded CV (not the preview).
CONTACT_PHONE=
# Strava (https://www.strava.com/settings/api) — refresh token needs read,activity:read scope
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=
# Optional: skips the /athlete lookup
STRAVA_ATHLETE_ID=
# Optional: where the Strava snapshot is persisted (default .next/cache/strava.json)
STRAVA_CACHE_FILE=

# Steam (https://steamcommunity.com/dev/apikey) — profile and game details must be Public
STEAM_API_KEY=
# 17-digit SteamID64
STEAM_ID=

# Rate limiting: how far to trust client-IP headers. Set this to match what sits in front of the app.
#   cloudflare - reachable ONLY through Cloudflare (uses cf-connecting-ip)
#   forwarded  - behind N reverse proxies (uses the entry they appended to x-forwarded-for; see HOPS)
#   (unset)    - legacy: first header found wins, which a direct caller can spoof
RATE_LIMIT_PROXY=
RATE_LIMIT_PROXY_HOPS=1

# --- Analytics (see docs/analytics.md) ---
# Start Umami with the portfolio. Remove to deploy without it.
COMPOSE_PROFILES=analytics
# Where the portfolio reaches Umami. Same compose file: http://umami:3000
ANALYTICS_UPSTREAM=http://umami:3000
# Dashboard address. Use an internal IP, never a public one.
UMAMI_BIND=127.0.0.1
UMAMI_PORT=3020
# Optional: keep Umami's database in a host folder (easy to back up) instead of a Docker volume.
# Use an absolute path. See docs/analytics.md before switching an existing install.
# UMAMI_DATA=/srv/umami-db

# Optional: show page views on blog posts. Use a view-only Umami user (Settings > Users).
UMAMI_API_USER=
UMAMI_API_PASSWORD=
